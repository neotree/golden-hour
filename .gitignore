# ---- Patient data: NEVER commit ----
input/*.csv
input/*.xlsx
input/*.xls

# ---- Generated outputs ----
output/**
!output/.gitkeep

# ---- Transient symlinks created by run_all.R at run time ----
# (these point at input/ and output/ so scripts find the sibling dirs they
#  expect; run_all.R recreates them on every run, they should never be
#  committed as either symlinks or, on platforms without symlink support,
#  as copied directories)
/00-DATA
/03-OUTPUTS
scripts/outputs

# ---- R session / project cruft ----
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# ---- OS / editor ----
.DS_Store
Thumbs.db
*~
.vscode/
